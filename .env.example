# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8082
# Connects as this domain's own user, on its own database - never as the administrator (Annex J, J.4).
MONGODB_URI=mongodb://catalog_app:<password>@mongo:27017/catalog?authSource=catalog
# Public key of the security service (one line, \n escapes) - or JWT_PUBLIC_KEY_FILE.
JWT_PUBLIC_KEY=
